APP_NAME="Vikings Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Two subdomains in prod (public marketing site vs franchise portal — see
# Plan.md's brand palette decision and App\Support\SiteTheme); left blank
# here since local dev has no real subdomains, so everything renders the
# public/Ember theme.
# PUBLIC_SITE_HOST=vikings.powerbear.co.za

# Sail host port overrides — uncomment and adjust if 80/6379/9000 are already
# taken by other local Docker projects (see README's Local Development section).
# APP_PORT=8090
# FORWARD_REDIS_PORT=6380
# FORWARD_MINIO_PORT=9001
# FORWARD_MINIO_CONSOLE_PORT=8901

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

SETTINGS_CACHE_ENABLED=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO locally emulates S3 (see Phase 0 in Plan.md); swap for real AWS creds/bucket in production.
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=local
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Sail: set to your host UID/GID (`id -u` / `id -g`) so container file ownership matches your user
WWWUSER=1000
WWWGROUP=1000
