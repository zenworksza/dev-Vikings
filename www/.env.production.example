# Template for the real `.env` deployed on the prod server (95.211.93.119,
# /var/www/vikings/www/.env) — never committed. Copy this, fill in the
# placeholders, and place it there; the root `compose.prod.yaml` loads it via
# `env_file` (and uses DB_* as the MySQL root/portal credentials). See README's Deploy convention and Plan.md.

APP_NAME="Vikings Portal"
APP_ENV=production
APP_KEY=                    # generate: docker compose --env-file www/.env -f compose.prod.yaml run --rm portal php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://vikings.powerbear.co.za    # swap to https:// once SSL is set up (deferred, see Plan.md)

# The public marketing site is a separate Laravel app (../site) with its own
# database; this app only serves franchise.powerbear.co.za. Used to link back.
PUBLIC_SITE_HOST=vikings.powerbear.co.za

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vikings
DB_USERNAME=vikings
DB_PASSWORD=                # generate a strong random password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false     # set true once served over HTTPS

CACHE_STORE=database
QUEUE_CONNECTION=redis
SETTINGS_CACHE_ENABLED=true

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# No SES/SMTP credentials provisioned yet (Plan.md: AWS account not set up) —
# `log` writes mail to storage/logs/laravel.log instead of sending, so
# registration/notification flows don't hard-fail. Swap for SES once the AWS
# account exists.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@vikingsfamily.example"
MAIL_FROM_NAME="${APP_NAME}"

# Franchisee-application documents live ONLY in an S3-compatible bucket
# (Z1 Storage), encrypted by the app before upload. In production the app
# refuses to store them anywhere else. See infra/storage/SETUP.txt.
DOCUMENTS_DISK=documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=vikingfranchise
AWS_ENDPOINT=https://s3.z1storage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
# Generate once (see infra/storage/SETUP.txt) and BACK IT UP off the server.
DOCUMENTS_ENCRYPTION_KEY=

# General (non-document) uploads still use local disk, persisted via the
# app-storage volume in compose.prod.yaml.
FILESYSTEM_DISK=local

APP_PORT=80
